# biomeddb uses a HOSTED Supabase project (not the local Docker stack).
# Copy to .env.local and fill in from the Supabase dashboard / CLI.
# Project Settings -> API for the URL + keys; Project Settings -> Database for the password.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used by the seed script and `supabase link`/migrations (not exposed to the browser).
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
